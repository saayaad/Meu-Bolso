## 17. REGRAS DE SEGURANÇA (REFERÊNCIA PARA OS ARQUIVOS)
Gere firestore.rules com base na estrutura abaixo, validando a sintaxe. Em todas as escritas, valide também os tipos dos campos principais (amountCents inteiro e maior que 0, type e status dentro dos valores permitidos).

    rules_version = '2';
    service cloud.firestore {
      match /databases/{database}/documents {
        function signedIn() { return request.auth != null; }
        function memberPath(wid) { return /databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid); }
        function isMember(wid) { return signedIn() && exists(memberPath(wid)); }
        function role(wid) { return get(memberPath(wid)).data.role; }
        function canEdit(wid) { return isMember(wid) && role(wid) in ['owner', 'editor']; }
        function isOwner(wid) { return isMember(wid) && role(wid) == 'owner'; }

        match /users/{uid}/{document=**} {
          allow read, write: if signedIn() && request.auth.uid == uid;
        }

        match /workspaces/{wid} {
          allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
          allow read: if isMember(wid);
          allow update, delete: if isOwner(wid);

          match /members/{uid} {
            allow read: if isMember(wid);
            allow create: if signedIn() && uid == request.auth.uid && (
              (request.resource.data.role == 'owner' &&
                get(/databases/$(database)/documents/workspaces/$(wid)).data.ownerId == request.auth.uid) ||
              (exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)) &&
                get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.workspaceId == wid &&
                get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.role == request.resource.data.role)
            );
            allow update: if isOwner(wid);
            allow delete: if isOwner(wid) || (signedIn() && uid == request.auth.uid);
          }

          match /{coll}/{docId} {
            allow read: if isMember(wid);
            allow write: if coll != 'members' && canEdit(wid);
          }
        }

        match /invites/{code} {
          allow get: if signedIn();
          allow list: if false;
          allow create: if signedIn() && isOwner(request.resource.data.workspaceId)
                        && request.resource.data.role in ['editor', 'viewer'];
          allow delete: if signedIn() && isOwner(resource.data.workspaceId);
        }
      }
    }

Storage (storage.rules):
- users/{uid}/...: leitura e escrita apenas pelo próprio uid; limite de 5 MB; somente imagens.
- workspaces/{wid}/receipts/...: leitura para membros do workspace e escrita para owner ou editor (consulta ao Firestore pelas funções firestore.exists e firestore.get); limite de 5 MB; somente imagens ou PDF.

